# PaySense: one environment file for both apps, for LOCAL development (D-74).
#
#   cp .env.example .env        then fill in the values marked REQUIRED
#
# Locally both apps read the repo-root .env if it exists: the backend through
# backend/app/core/settings.py (backend/.env, if present, wins), the frontend through
# frontend/next.config.ts (frontend/.env.local, if present, wins). Deploys never see this file:
# Render gets backend/ only and Vercel gets frontend/ only; their variables are listed in
# backend/.env.example and frontend/.env.example and set in each dashboard.
# Every variable, where to get it and what reads it: docs/env_setup.md.
# Never put a real key in this file: it is committed and the repo is public.
# The values below run the app locally with no database account and no paid key.

# ---------------------------------------------------------------- database (D-71)
# memory   = local only: in-memory database with demo students aina, hafiz, meiling (resets on restart)
# supabase = production: needs SUPABASE_URL and SUPABASE_SERVICE_KEY
DB_BACKEND=memory
LOCAL_DEMO_PASSPHRASE=paysense-local-demo
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------- sessions and CORS (REQUIRED)
# SESSION_SECRET: 32+ characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Frontend origins, comma-separated, no trailing slash. Production: the Vercel URL.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- assistant (D-47, D-53, D-70)
# groq | gemini | anthropic | none. No key for the chosen provider = guided mode (no model).
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Empty = the provider's default model (groq: llama-3.3-70b-versatile)
ASSISTANT_MODEL=
ASSISTANT_ENABLED=true
# Keep transaction descriptions away from the model provider
ASSISTANT_REDACT_DESCRIPTIONS=true

# ---------------------------------------------------------------- sign in with Google (D-69)
# On only when the client ID, secret and API_PUBLIC_URL are all set. Register exactly
# API_PUBLIC_URL/api/auth/google/callback as the OAuth client's redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:8000
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- frontend (public: inlined into the browser bundle)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# true shows "Continue with Google"; set it only when the three Google values above are set
NEXT_PUBLIC_GOOGLE_SIGNIN=false

# ---------------------------------------------------------------- limits (optional; these are the defaults)
DAILY_WRITE_QUOTA=300
ASSISTANT_USER_DAILY_TOKENS=200000
ASSISTANT_GLOBAL_DAILY_TOKENS=3000000
ASSISTANT_DAILY_REQUESTS=300
ASSISTANT_MAX_TOOL_CALLS=6
ASSISTANT_MAX_OUTPUT_TOKENS=1024
ASSISTANT_TIMEOUT_SECONDS=45
ASSISTANT_HISTORY_TURNS=8
ASSISTANT_ACTION_TTL_MINUTES=10

# ---------------------------------------------------------------- production only (Render)
# Read by uvicorn, not the app: the platform's proxy range, never "*" (docs/deployment.md)
# FORWARDED_ALLOW_IPS=
