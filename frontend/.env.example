# PaySense app: the environment for frontend/ only (D-74).
#
#   cd frontend && cp .env.example .env.local
#
# Next.js reads frontend/.env.local; the repo root is never read, so the app deploys from this
# folder alone. Documented in docs/env_setup.md. Never commit .env.local.
# On Vercel, set the same names in the project's Environment Variables before the build.
#
# Both values are public by design: NEXT_PUBLIC_* is inlined into the browser bundle. No secret
# belongs here; the API holds every key.

# The API's base URL, no trailing slash. The Content-Security-Policy allows the app to talk to this
# origin and nowhere else. Locally: http://localhost:8000. On Vercel: the Render service URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# true shows "Continue with Google"; set it only when Google sign-in is configured in backend/.env
NEXT_PUBLIC_GOOGLE_SIGNIN=false
