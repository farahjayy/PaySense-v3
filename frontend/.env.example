# Copy to frontend/.env.local and fill in. Never commit .env.local.
# Documented in docs/env_setup.md.

# The API's base URL, no trailing slash. Public by design: it is built into the browser bundle,
# and the Content-Security-Policy allows the app to talk to this origin and nowhere else.
# Locally: http://localhost:8000. On Vercel: the Render service URL (set it before the build).
NEXT_PUBLIC_API_BASE_URL=
