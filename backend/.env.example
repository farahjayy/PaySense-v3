# Copy to backend/.env and fill in. Never commit .env.
# Every variable is documented in docs/env_setup.md.

# Required
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SESSION_SECRET=
CORS_ORIGINS=http://localhost:3000

# Optional
SESSION_TTL_HOURS=12
MODEL_DIR=
MC_PATHS=1000
ANTHROPIC_API_KEY=

# Sign in with Google (ADR D-69): off unless the first three are set.
# Redirect URI to register in Google Cloud: API_PUBLIC_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:8000
APP_URL=http://localhost:3000
